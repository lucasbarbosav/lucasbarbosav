# Copie para .env (que NAO e versionado) e preencha.

# Chave publica da API do DataJud (CNJ).
# Obtenha em: https://datajud-wiki.cnj.jus.br/api-publica/acesso
# NAO ha chave padrao neste repositorio de proposito: nao inventamos credencial.
DATAJUD_API_KEY=

# Intervalo minimo, em segundos, entre requisicoes ao DataJud (rate limit conservador).
DATAJUD_SLEEP_S=1.5

# Janela temporal padrao das series (AAAA-MM-DD).
JANELA_INICIO=2020-01-01

# ---------------------------------------------------------------------------
# Fonte 6 — Zoho Desk (censo de entrega da informacao SAC <-> areas internas)
# Como obter as credenciais: docs/desk_como_obter_acesso.md
ZOHO_DESK_ORG_ID=855775513
ZOHO_DESK_DEPARTMENT_ID=1003707000000006907
ZOHO_DESK_CLIENT_ID=
ZOHO_DESK_CLIENT_SECRET=
ZOHO_DESK_REFRESH_TOKEN=
# alternativa de curta duracao (ignora o trio acima enquanto valer):
ZOHO_DESK_ACCESS_TOKEN=
# intervalo minimo entre chamadas (rate limit do plano)
ZOHO_DESK_SLEEP_S=0.75
# janela do censo
DESK_JANELA_INICIO=2026-01-01
DESK_JANELA_FIM=2026-08-21
# dominios internos extras, separados por virgula (os do grupo ja sao padrao)
DESK_DOMINIOS_INTERNOS=
# passada de LLM nos ambiguos (python -m src.desk_entrega --llm)
ANTHROPIC_API_KEY=
DESK_LLM_MODEL=claude-opus-5
